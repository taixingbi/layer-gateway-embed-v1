# Server
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=30181

# Optional YAML config (production / k8s). When set and file exists, env backend/routing/admission vars are ignored.
# GATEWAY_CONFIG=/app/config.yaml

# Backends (name=url,name=url) — used when GATEWAY_CONFIG is unset
EMBED_BACKENDS=embed-node-1=http://192.168.86.173:8001,embed-node-2=http://192.168.86.176:8001
EMBED_BACKEND_SOFT_LIMIT=32
EMBED_BACKEND_HARD_LIMIT=64

# Upstream HTTP timeouts
TIMEOUT_CONNECT_MS=1000
TIMEOUT_READ_MS=15000

# Retry policy
RETRY_MAX_ATTEMPTS=2

# Admission queue
ADMISSION_MAX_CONCURRENT=128
ADMISSION_WAIT_TIMEOUT_MS=500

# Circuit breaker
CB_FAILURE_THRESHOLD=5
CB_RESET_TIMEOUT_SEC=30
CB_HALF_OPEN_MAX_PROBES=1
CB_HALF_OPEN_SUCCESS_THRESHOLD=1

# Routing score: inflight*W1 + latency*W2 + error_rate*W3 + hot_penalty + overload_penalty
ROUTING_INFLIGHT_WEIGHT=8.0
ROUTING_LATENCY_WEIGHT=0.5
ROUTING_ERROR_WEIGHT=100.0
ROUTING_HOT_PENALTY_WEIGHT=20.0
ROUTING_OVERLOAD_PENALTY_WEIGHT=15.0
ROUTING_HOT_WINDOW_SEC=2.0
ROUTING_HOT_TARGET_SHARE=0.55
# Optional legacy controls (disabled by default; inference gateway uses score-only)
ROUTING_EXPLORATION_RATE=0.0
ROUTING_MAX_IDLE_MS=0

# Logging
LOG_LEVEL=INFO
LOG_JSON=true
