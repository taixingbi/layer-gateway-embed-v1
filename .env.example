INTERNAL_API_KEY=

EMBEDDING_BACKENDS=192.168.86.173:8001,192.168.86.176:8001
ROUTER_STRATEGY=failover
ROUTER_PORT=8011
ROUTER_MAX_CONCURRENT=20
ROUTER_REQUEST_TIMEOUT=60.0
ROUTER_RETRY_ATTEMPTS=1
# Optional: log upstream response header value as gpu= on successful proxy (set on vLLM/nginx, e.g. X-GPU-Id)
# ROUTER_GPU_TRACE_HEADER=X-GPU-Id
ENV=dev

# Optional: ship logs to Grafana Cloud Loki (omit token to log stderr only)
GRAFANA_CLOUD_URL=https://logs-prod-XXX.grafana.net
GRAFANA_CLOUD_USER=your-stack-user-id
GRAFANA_CLOUD_WRITE_API_KEY=your-loki-write-token
